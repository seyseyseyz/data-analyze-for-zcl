{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spine_brief.json",
  "title": "spine_brief",
  "description": "Runtime spine payload nested inside candidate and adjudication envelopes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decomposition_backbone",
    "headline_candidate",
    "section_callbacks",
    "broadcast_facts"
  ],
  "properties": {
    "decomposition_backbone": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link_id", "from", "to", "anchor_fact_ids", "relation"],
        "properties": {
          "link_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "anchor_fact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "relation": {"enum": ["accounting_identity", "weak_causal_overlay"]}
        }
      }
    },
    "headline_candidate": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^0-9０-９]*$",
      "description": "Number-free candidate headline; numeric evidence stays in claims."
    },
    "section_callbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["must_connect_to", "angle_hint"],
        "properties": {
          "must_connect_to": {"type": "string", "minLength": 1},
          "angle_hint": {"type": "string", "minLength": 1}
        }
      }
    },
    "broadcast_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "cannot_say": {"type": "array", "items": {"type": "string"}}
  }
}
