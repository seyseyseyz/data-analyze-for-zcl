{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "targeted_revision.json",
  "title": "targeted_revision",
  "description": "One bounded replacement or deletion addressed to a claim_id, view_id or action_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "round",
    "target_type",
    "target_id",
    "operation",
    "source_blocker_ids",
    "replacement",
    "reason"
  ],
  "properties": {
    "revision_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "target_type": {"enum": ["claim", "view", "action"]},
    "target_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["replace", "drop"]},
    "source_blocker_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "replacement": {
      "oneOf": [
        {"$ref": "claim.json"},
        {"$ref": "view_spec.json"},
        {"$ref": "action_card.json"},
        {"type": "null"}
      ]
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "drop"}}},
      "then": {"properties": {"replacement": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "replace"}, "target_type": {"const": "claim"}},
        "required": ["operation", "target_type"]
      },
      "then": {"properties": {"replacement": {"$ref": "claim.json"}}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "replace"}, "target_type": {"const": "view"}},
        "required": ["operation", "target_type"]
      },
      "then": {"properties": {"replacement": {"$ref": "view_spec.json"}}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "replace"}, "target_type": {"const": "action"}},
        "required": ["operation", "target_type"]
      },
      "then": {"properties": {"replacement": {"$ref": "action_card.json"}}}
    }
  ]
}
